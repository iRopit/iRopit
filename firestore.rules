rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own user document
    match /users/{userId} {
      // Owner has full access; any authenticated user can read basic profile (for email lookup during device sharing)
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Devices subcollection
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Notifications (SMS, calls) under each device
        match /notifications/{notifId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Contacts under each device
        match /contacts/{contactId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Calls under each device
        match /calls/{callId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Live ringing call state (written by mobile, read by extension)
        match /ringing_call/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Live outgoing call state (written by mobile, read by extension)
        match /outgoing_call/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Messages under each device
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // User-level notifications
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User-level messages
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level devices collection
    match /devices/{deviceId} {
      // Any authenticated user can read device docs (shared devices need recipient access;
      // app-level logic controls what is displayed to each user)
      allow read: if request.auth != null;
      // create/update: caller must write their own userId
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // delete: caller must own the document they are deleting
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // SMS requests (for sending SMS via Android device)
    match /sms_requests/{requestId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Call requests (for initiating calls via Android device)
    match /call_requests/{requestId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Push notifications (Chrome extension → mobile app)
    match /push_notifications/{notifId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Top-level SMS and calls collections (legacy)
    match /sms/{docId} {
      allow read, write: if request.auth != null;
    }

    match /calls/{docId} {
      allow read, write: if request.auth != null;
    }

    // Device sharing
    match /deviceShares/{shareId} {
      // Owner can create/update/delete their own shares
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      // Both owner and recipient can read a share
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.sharedWithUid == request.auth.uid
      );
      // Recipient can also delete (to remove shared device from their list)
      allow delete: if request.auth != null && resource.data.sharedWithUid == request.auth.uid;
    }
  }
}
